# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Indentação de 4 espaços será aplicada a linguagens que a exigirem
# quando a stack for definida (ex.: Python).
